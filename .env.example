OPS_IMAGE=ghcr.io/<owner>/abdspace-ops:latest

DOCKER_API_URL=http://docker-socket-proxy:2375
DASHBOARD_DOCKER_MODE=swarm
DASHBOARD_SERVICES=Web=example-web,API=example-api,Database=example-db
DASHBOARD_DEPLOYMENTS=Web=example-web,API=example-api
DASHBOARD_LINKS=Dokploy=https://dokploy.example.com,Uptime Kuma=https://status.example.com

DASHBOARD_DISK_PATH=/host-disk

BACKUP_LOG_HOST_PATH=/var/log/example-backup.log
BACKUP_LOG_PATH=/backups/backup.log
BACKUP_LOG_SUCCESS_PATTERN=completed|success
BACKUP_MAX_AGE_HOURS=26
BACKUP_RETENTION_DAYS=14
TZ=UTC

UPTIME_KUMA_URL=
UPTIME_KUMA_STATUS_SLUG=

CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
DASHBOARD_REQUIRE_CF_ACCESS=false
